{
  "$schema": "./node_modules/ng-packagr/package.schema.json",
  "name": "ngx-currency-demo",
  "version": "3.0.2",
  "description": "A very simple currency mask directive that allows using a number attribute with the ngModel.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ngx-currency && copyfiles README.md LICENSE.txt dist/ngx-currency/",
    "release": "commit-and-tag-version",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-currency",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "bootstrap": "^5.3.3",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-angular": "^19.6.0",
    "@types/jasmine": "~5.1.4",
    "angular-eslint": "^21.3.0",
    "commit-and-tag-version": "^12.5.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.3",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.15.0"
  }
}
